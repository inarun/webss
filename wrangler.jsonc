{
  "name": "webss",
  "compatibility_date": "2026-07-09",
  "main": "worker.js",
  // No id: the deploy creates the namespace and keeps it linked by binding name.
  "kv_namespaces": [{ "binding": "WRITING" }],
  "triggers": { "crons": ["23 * * * *"] },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/media/ledger/video/*", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
